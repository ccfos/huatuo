  "x-error-codes": {
    "execution_capacity_exceeded": {
      "description": "The target node has no execution capacity for this Job.",
      "httpStatus": 429
    },
    "execution_failed": {
      "description": "The execution failed.",
      "httpStatus": 500
    },
    "execution_start_failed": {
      "description": "The execution could not be started.",
      "httpStatus": 500
    },
    "execution_timed_out": {
      "description": "The Job exceeded its execution deadline and was stopped.",
      "httpStatus": 500
    },
    "job_conflict": {
      "description": "The requested Job transition conflicts with its current state.",
      "httpStatus": 409
    },
    "job_not_found": {
      "description": "The requested Job does not exist.",
      "httpStatus": 404
    },
    "node_unavailable": {
      "description": "The target node is unavailable.",
      "httpStatus": 503
    },
    "operation_lost": {
      "description": "The node can no longer verify an observed Operation.",
      "httpStatus": 500
    },
    "protocol_error": {
      "description": "The node response does not satisfy the execution protocol.",
      "httpStatus": 502
    },
    "quota_exceeded": {
      "description": "The request exceeds the caller's Job quota.",
      "httpStatus": 429
    },
    "result_not_found": {
      "description": "The published Profiling result does not exist or has expired.",
      "httpStatus": 404
    },
    "result_not_ready": {
      "description": "The Job state does not permit result access.",
      "httpStatus": 409
    },
    "result_too_large": {
      "description": "The requested raw Profiling result page exceeds the response limit.",
      "httpStatus": 413
    },
    "result_unavailable": {
      "description": "The Job terminal state does not guarantee a complete result.",
      "httpStatus": 409
    },
    "start_timeout": {
      "description": "The Job did not start before its pending deadline.",
      "httpStatus": 500
    },
    "stop_timeout": {
      "description": "The Job did not stop before its stop deadline.",
      "httpStatus": 500
    }
  }
}
