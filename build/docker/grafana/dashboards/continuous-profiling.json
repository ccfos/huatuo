	"templating": {
		"list": [
			{
				"name": "region",
				"label": "Region",
				"type": "query",
				"datasource": {
					"type": "elasticsearch",
					"uid": "huatuo-bamai-es"
				},
				"query": "{\n  \"find\": \"terms\",\n  \"field\": \"region.keyword\",\n  \"query\": \"_exists_:profile_data.profile_type\",\n  \"size\": 5000\n}",
				"definition": "{\n  \"find\": \"terms\",\n  \"field\": \"region.keyword\",\n  \"query\": \"_exists_:profile_data.profile_type\",\n  \"size\": 5000\n}",
				"refresh": 2,
				"options": [],
				"allowCustomValue": false,
				"multi": false
			},
			{
				"name": "hostname",
				"label": "Node (hostname)",
				"type": "query",
				"datasource": {
					"type": "elasticsearch",
					"uid": "huatuo-bamai-es"
				},
				"query": "{\n  \"find\": \"terms\",\n  \"field\": \"hostname.keyword\",\n  \"query\": \"region.keyword:${region:lucene} AND _exists_:profile_data.profile_type\",\n  \"size\": 5000\n}",
				"definition": "{\n  \"find\": \"terms\",\n  \"field\": \"hostname.keyword\",\n  \"query\": \"region.keyword:${region:lucene} AND _exists_:profile_data.profile_type\",\n  \"size\": 5000\n}",
				"refresh": 2,
				"options": [],
				"allowCustomValue": false,
				"multi": false
			},
			{
				"name": "scope",
				"label": "Scope",
				"type": "custom",
				"query": "host : NOT _exists_:container_id,container : _exists_:container_id",
				"current": {
					"text": "host",
					"value": "NOT _exists_:container_id"
				},
				"options": [
					{
						"text": "host",
						"value": "NOT _exists_:container_id",
						"selected": true
					},
					{
						"text": "container",
						"value": "_exists_:container_id",
						"selected": false
					}
				],
				"multi": false,
				"includeAll": false
			},
			{
				"name": "container_id",
				"label": "Container ID (container scope)",
				"type": "query",
				"datasource": {
					"type": "elasticsearch",
					"uid": "huatuo-bamai-es"
				},
				"query": "{\n  \"find\": \"terms\",\n  \"field\": \"container_id.keyword\",\n  \"query\": \"region.keyword:${region:lucene} AND hostname.keyword:${hostname:lucene} AND (${scope:raw})\",\n  \"size\": 5000\n}",
				"definition": "{\n  \"find\": \"terms\",\n  \"field\": \"container_id.keyword\",\n  \"query\": \"region.keyword:${region:lucene} AND hostname.keyword:${hostname:lucene} AND (${scope:raw})\",\n  \"size\": 5000\n}",
				"refresh": 2,
				"options": [],
				"allowCustomValue": false,
				"multi": false,
				"includeAll": true,
				"allValue": "*",
				"current": {
					"text": "All",
					"value": "$__all"
				}
			},
			{
				"name": "type",
				"label": "Profile type",
				"type": "query",
				"datasource": {
					"type": "elasticsearch",
					"uid": "huatuo-bamai-es"
				},
				"query": "{\n  \"find\": \"terms\",\n  \"field\": \"profile_data.profile_type.keyword\",\n  \"query\": \"region.keyword:${region:lucene} AND hostname.keyword:${hostname:lucene} AND (${scope:raw}) AND (container_id.keyword:${container_id:lucene} OR (*:* AND NOT _exists_:container_id))\",\n  \"size\": 5000\n}",
				"definition": "{\n  \"find\": \"terms\",\n  \"field\": \"profile_data.profile_type.keyword\",\n  \"query\": \"region.keyword:${region:lucene} AND hostname.keyword:${hostname:lucene} AND (${scope:raw}) AND (container_id.keyword:${container_id:lucene} OR (*:* AND NOT _exists_:container_id))\",\n  \"size\": 5000\n}",
				"refresh": 2,
				"options": [],
				"allowCustomValue": false,
				"multi": false
			},
			{
				"name": "task_id",
				"label": "Task ID",
				"type": "query",
				"datasource": {
					"type": "elasticsearch",
					"uid": "huatuo-bamai-es"
				},
				"query": "{\n  \"find\": \"terms\",\n  \"field\": \"tracer_id.keyword\",\n  \"query\": \"region.keyword:${region:lucene} AND hostname.keyword:${hostname:lucene} AND (${scope:raw}) AND (container_id.keyword:${container_id:lucene} OR (*:* AND NOT _exists_:container_id)) AND profile_data.profile_type.keyword:${type:lucene}\",\n  \"size\": 5000\n}",
				"definition": "{\n  \"find\": \"terms\",\n  \"field\": \"tracer_id.keyword\",\n  \"query\": \"region.keyword:${region:lucene} AND hostname.keyword:${hostname:lucene} AND (${scope:raw}) AND (container_id.keyword:${container_id:lucene} OR (*:* AND NOT _exists_:container_id)) AND profile_data.profile_type.keyword:${type:lucene}\",\n  \"size\": 5000\n}",
				"refresh": 2,
				"options": [],
				"allowCustomValue": false,
				"multi": false,
				"description": "Select one task. Changing Region, node, scope or profile type refreshes available tasks."
			},
			{
				"name": "container_name",
				"label": "Container name",
				"type": "query",
				"datasource": {
					"type": "elasticsearch",
					"uid": "huatuo-bamai-es"
				},
				"query": "{\n  \"find\": \"terms\",\n  \"field\": \"container_hostname.keyword\",\n  \"query\": \"region.keyword:${region:lucene} AND hostname.keyword:${hostname:lucene} AND tracer_id.keyword:${task_id:lucene}\",\n  \"size\": 5000\n}",
				"definition": "{\n  \"find\": \"terms\",\n  \"field\": \"container_hostname.keyword\",\n  \"query\": \"region.keyword:${region:lucene} AND hostname.keyword:${hostname:lucene} AND tracer_id.keyword:${task_id:lucene}\",\n  \"size\": 5000\n}",
				"refresh": 2,
				"options": [],
				"allowCustomValue": false,
				"multi": false,
				"hide": 2
			}
		]
	},
