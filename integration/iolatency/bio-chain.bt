// Observe actual request bio chains without issuing IO or changing devices.
// Usage: timeout --signal=INT 180s bpftrace bio-chain.bt MAJOR FIRST_MINOR
// Both qualification kernels expose request.rq_disk. Kprobe misses can omit
// observations; only a positive >128 observation establishes long-chain coverage.
// max_length is capped at 512; seen_over_512 reports a non-NULL remaining tail.

BEGIN
{
	@seen_over_128 = 0;
	@seen_over_512 = 0;
	printf("observing request bio chains on %d:%d; scan limit=512\n", $1, $2);
}

kprobe:blk_mq_start_request
{
	$request = (struct request *)arg0;
	$disk = $request->rq_disk;
	if ($disk != 0 && $disk->major == $1 && $disk->first_minor == $2) {
		$bio = $request->bio;
		$length = 0;
		unroll(8) {
			unroll(64) {
				if ($bio != 0) {
					$length++;
					$bio = $bio->bi_next;
				}
			}
		}
		@max_length = max($length);
		@lengths[$length] = count();
		if ($length > 128) {
			@seen_over_128 = 1;
		}
		if ($bio != 0) {
			@seen_over_512 = 1;
		}
	}
}
